######################################################
#   Maural KMS — Example Environment Variables
#   Copy this file to .env and fill in your values.
#   Never commit a .env file with real secrets.
######################################################


######################################################
#                   App Settings
######################################################
NODE_ENV=development           # development | production
HOST=localhost                 # Use 0.0.0.0 in Docker / Railway
PORT=5000
DISABLE_AUTH=false             # Set true only in development to skip auth checks


######################################################
#                     CORS
######################################################
# Comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:5173


######################################################
#                Clerk Auth Settings
######################################################
# Obtain from: https://dashboard.clerk.com → Your App → API Keys
CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Obtain from: Clerk Dashboard → Configure → Webhooks → Add Endpoint → Signing Secret
CLERK_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx


######################################################
#              Database Connection Strings
######################################################
# Obtain from: Supabase Dashboard → Project → Settings → Database → Connection String

# Pooled connection — used by the app at runtime (port 6543, pgbouncer=true)
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true

# Direct connection — used by Prisma migrations only (port 5432)
DIRECT_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres


######################################################
#                 Supabase Settings
######################################################
# Obtain from: Supabase Dashboard → Project → Settings → API

SUPABASE_URL=https://[project-ref].supabase.co
SUPABASE_ANON_KEY=eyJ...          # anon / public key
SUPABASE_SERVICE_ROLE_KEY=eyJ...  # service_role key (keep secret — used by ingest pipeline)


######################################################
#                 OpenAI Settings
######################################################
# Obtain from: https://platform.openai.com → API Keys
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Chat model used by the AI chatbot and RAG pipeline
OPENAI_CHAT_MODEL=gpt-4o-mini      # Options: gpt-4o, gpt-4o-mini, gpt-3.5-turbo

# Embedding model used for document ingestion and retrieval
# WARNING: changing this requires dropping and recreating the document_embeddings
# table and re-ingesting all documents. See Technical Reference Manual, Section 9.
OPENAI_EMBED_MODEL=text-embedding-3-small   # Options: text-embedding-3-small, text-embedding-3-large

# Minimum confidence score (0–100) the guardrail requires before returning an AI answer
GUARDRAIL_CONFIDENCE_THRESHOLD=90


######################################################
#                 Frontend URLs
######################################################
FRONTEND_URL=http://localhost:5173
FRONTEND_REDIRECT_URI=http://localhost:5173/integrations


######################################################
#           HubSpot Integration Settings
######################################################
# Obtain from: https://developers.hubspot.com → Your App → Auth
HUBSPOT_CLIENT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
HUBSPOT_CLIENT_SECRET=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
HUBSPOT_REDIRECT_URI=http://localhost:5000/api/integrations/hubspot/oauth-callback


######################################################
#           QuickBooks Integration Settings
######################################################
# Obtain from: https://developer.intuit.com → Your App → Keys & OAuth
QUICKBOOKS_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
QUICKBOOKS_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
QUICKBOOKS_REDIRECT_URI=http://localhost:5000/api/integrations/quickbooks/oauth-callback
QUICKBOOKS_ENVIRONMENT=sandbox    # sandbox | production
QUICKBOOKS_BASE_URL=https://sandbox-quickbooks.api.intuit.com  # sandbox
# QUICKBOOKS_BASE_URL=https://quickbooks.api.intuit.com        # production


######################################################
#           Monday.com Integration Settings
######################################################
# Obtain from: https://monday.com/developers/apps → Your App → OAuth
MONDAY_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
MONDAY_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
MONDAY_REDIRECT_URI=http://localhost:5000/api/integrations/monday/oauth-callback


######################################################
#           ClickUp Integration Settings
######################################################
# Obtain from: https://app.clickup.com/settings/apps → Create App → OAuth
CLICKUP_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CLICKUP_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CLICKUP_REDIRECT_URI=http://localhost:5000/api/integrations/clickup/oauth-callback
