# Dependencies
/node_modules

# Environment files — keep the example template, ignore everything else
.env*
!.env.example

# Uploaded files — keep the directory, ignore contents
/uploads/*
!/uploads/.gitkeep

# Test output
/coverage/
/test-reports

# Logs
npm-debug.log*

# Tesseract OCR language data (downloaded at runtime)
*.traineddata

# IDEs and OS
.vscode/
.DS_Store

# Local documentation (not for repo)
docs-assets/
