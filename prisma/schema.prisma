generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "postgresql"
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model Organisation {
    org_id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
    org_name           String
    industry           String?
    founded            DateTime? @db.Date
    key_contacts       BigInt?
    company_location   String?
    organization_chart String?
    gpt_types          String?
    storage_bucket     String    @default(dbgenerated("gen_random_uuid()")) @db.Uuid

    // Platform flag — true only for the "Maural Solutions" admin org
    is_platform          Boolean @default(false)

    // Integration connection flags (auto-set when tokens are created/deleted)
    hubspot_connected    Boolean @default(false)
    quickbooks_connected Boolean @default(false)
    monday_connected     Boolean @default(false)
    clickup_connected    Boolean @default(false)

    User               User[]
    File               File[]
    financeKpis        FinanceKpi[]
    leadsKpis          LeadsKpi[]
    laborKpis          LaborKpi[]
    hubspotTokens      HubspotToken[]
    quickbooksTokens   QuickbooksToken[]
    mondayTokens       MondayToken[]
    clickupTokens      ClickUpToken[]
    documentEmbeddings document_embeddings[]
    vto                VTO?
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model Category {
    ctg_id   BigInt  @id @unique @default(autoincrement())
    ctg_name String?
    File     File[]
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model File {
    file_id      String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
    file_name    String
    file_size    Float
    file_source  String
    ctg_id       BigInt? // Document category FK → Category (e.g. legal, financial, hr)
    org_id       String?       @db.Uuid // Which organisation owns this file (FK → Organisation)
    user_id      BigInt? // Which user uploaded it (FK → User)
    Category     Category?     @relation(fields: [ctg_id], references: [ctg_id])
    Organisation Organisation? @relation(fields: [org_id], references: [org_id])
    User         User?         @relation(fields: [user_id], references: [user_id])
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model Permission {
    permission_id   BigInt           @id @default(autoincrement())
    permission_name String
    RolePermission  RolePermission[]
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model Role {
    role_id        BigInt           @id @unique @default(autoincrement())
    role_name      String
    RolePermission RolePermission[]
    User           User[]
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model User {
    org_id       String?       @db.Uuid
    role_id      BigInt?
    clerk_id     String?       @unique
    first_name   String
    last_name    String
    email        String
    phone        String?
    gender       String?
    status       String?
    job_title    String?
    last_login   DateTime?     @db.Timestamp(6)
    user_id      BigInt        @id @unique @default(autoincrement())
    File         File[]
    Organisation Organisation? @relation(fields: [org_id], references: [org_id], onDelete: SetNull)
    Role         Role?         @relation(fields: [role_id], references: [role_id])
}

model HubspotToken {
    org_id        String       @id @db.Uuid
    access_token  String
    refresh_token String
    expires_at    DateTime
    created_at    DateTime?    @default(now())
    updated_at    DateTime?
    Organisation  Organisation @relation(fields: [org_id], references: [org_id], onDelete: Cascade)

    @@map("hubspot_tokens")
}

model QuickbooksToken {
    org_id                     String       @id @db.Uuid
    access_token               String
    refresh_token              String
    token_type                 String
    expires_in                 Int
    x_refresh_token_expires_in Int
    realmId                    BigInt
    Organisation               Organisation @relation(fields: [org_id], references: [org_id], onDelete: Cascade)

    @@map("quickbooks_tokens")
}

model MondayToken {
    id                       Int          @id @default(autoincrement())
    org_id                   String       @unique @db.Uuid
    access_token             String
    refresh_token            String?
    token_type               String?
    realm_id                 String?
    expires_in               Int?
    refresh_token_expires_in Int?
    created_at               DateTime     @default(now())
    updated_at               DateTime     @updatedAt
    Organisation             Organisation @relation(fields: [org_id], references: [org_id], onDelete: Cascade)

    @@map("monday_tokens")
}

model ClickUpToken {
    org_id        String       @id @db.Uuid
    access_token  String
    refresh_token String
    token_type    String
    expires_at    DateTime
    created_at    DateTime?    @default(now())
    updated_at    DateTime?
    Organisation  Organisation @relation(fields: [org_id], references: [org_id], onDelete: Cascade)

    @@map("clickup_tokens")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model RolePermission {
    role_id       BigInt
    permission_id BigInt
    Permission    Permission @relation(fields: [permission_id], references: [permission_id], onDelete: Cascade)
    Role          Role       @relation(fields: [role_id], references: [role_id], onDelete: Cascade)

    @@id([role_id, permission_id])
}

model document_embeddings {
    id           BigInt                @id @default(autoincrement())
    content      String
    metadata     Json?                 @default("{}")
    embedding    Unsupported("vector")
    org_id       String?               @db.Uuid
    Organisation Organisation?         @relation(fields: [org_id], references: [org_id], onDelete: Cascade)

    @@index([embedding])
    @@index([org_id])
}

model FinanceKpi {
    id           String       @id @default(cuid())
    org_id       String       @db.Uuid
    organisation Organisation @relation(fields: [org_id], references: [org_id])

    // Period this snapshot covers
    periodStart DateTime
    periodEnd   DateTime
    asOfDate    DateTime? // for balance sheet point-in-time

    // ── Profit & Loss (FIN-1 to FIN-4) ───────────────────
    totalIncome   Float? // FIN-1
    cogs          Float?
    grossProfit   Float? // FIN-2
    grossMargin   Float? // grossProfit / totalIncome %
    totalExpenses Float?
    netIncome     Float? // FIN-4
    netMargin     Float? // netIncome / totalIncome %

    // ── EBITDA (FIN-3, PS-3) ──────────────────────────────
    ebitda       Float? // FIN-3
    ebitdaMargin Float? // PS-3 target: 20–40%

    // ── Balance Sheet (FIN-5) ─────────────────────────────
    cashPosition            Float? // FIN-5
    accountsReceivable      Float?
    totalCurrentAssets      Float?
    totalCurrentLiabilities Float?

    // ── Cash KPIs (CASH-1, CASH-2) ───────────────────────
    monthlyBurn  Float? // CASH-1: COGS + OpEx + Owner Distributions
    netBurnRate  Float?
    runwayMonths Float? // CASH-2: cashPosition / monthlyBurn

    // ── Prof Svcs KPIs ────────────────────────────────────
    workingCapital Float? // PS-4: current assets - current liabilities
    dso            Float? // PS-5: days sales outstanding

    // ── Valuation (VALUE-1, VALUE-2) ─────────────────────
    ruleOf40        Float? // VALUE-1: 3yr CAGR + EBITDA%
    enterpriseValue Float? // VALUE-2: TTM EBITDA * multiple

    // ── Variance KPIs (Budget vs Actuals) ────────────────
    varianceRevenuePct           Float?
    varianceCOGSPct              Float?
    varianceGrossProfitPct       Float?
    varianceOperatingExpensesPct Float?
    varianceNetIncomePct         Float?
    varianceEBITDAPct            Float?

    // ── Cache metadata ────────────────────────────────────
    lastFetchedAt DateTime @default(now())
    fetchSource   String   @default("quickbooks") // source of truth
    isStale       Boolean  @default(false)

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    // One snapshot per organisation per period
    @@unique([org_id, periodStart, periodEnd])
    @@index([org_id, lastFetchedAt])
    @@map("finance_kpis")
}

model LeadsKpi {
    id           String       @id @default(cuid())
    org_id       String       @db.Uuid
    organisation Organisation @relation(fields: [org_id], references: [org_id])

    periodStart DateTime
    periodEnd   DateTime

    // ── Pipeline KPIs (LEADS-1 to LEADS-5) ───────────────
    leads          Int? // LEADS-1: MQLs + SQLs
    calls          Int? // LEADS-2
    proposals      Int? // LEADS-3
    dealsWon       Int? // LEADS-4
    conversionRate Float? // LEADS-5: deals won / proposals

    // ── Revenue KPIs (PS-6, PS-9) ─────────────────────────
    pipelineCoverage Float? // PS-6: proposed work / revenue goal
    recurringRevenue Float? // PS-9 raw value
    recurringPercent Float? // PS-9 %: recurring / total revenue
    oneTimeRevenue   Float? // total - recurring

    // ── Organisation Health KPIs (PS-8, PS-14) ──────────────
    clientConcentration    Float? // PS-8: top 5 client revenue %
    founderDependencySales Float? // PS-14: founder revenue / total

    // ── Custom KPIs (need clarification — flagged in table) ──
    dealVelocity       Float? // avg days lead → close
    forecastAccuracy   Float? // actual / forecasted revenue %
    retentionRate      Float? // retained clients / starting count
    customerEngagement Float? // TBD — email/call activity score

    // ── Segment breakdown (stored as JSON for flexibility) ──
    // e.g. { "consulting": 45000, "retainer": 30000, "project": 15000 }
    revenuePerSegment Json? // PS-* custom segment breakdown

    lastFetchedAt DateTime @default(now())
    isStale       Boolean  @default(false)

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@unique([org_id, periodStart, periodEnd])
    @@index([org_id, lastFetchedAt])
    @@map("leads_kpis")
}

model LaborKpi {
    id        String   @id @default(cuid())
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    // Organisation scoping
    org_id       String       @db.Uuid
    organisation Organisation @relation(fields: [org_id], references: [org_id])

    // Period
    periodStart DateTime
    periodEnd   DateTime

    // Source — "monday" | "clickup"
    laborSource String

    // ── LABOR-3: Direct labor hours
    directLaborHours Float?

    // ── LABOR-4 / LABOR-5: Headcount
    billableFTEs    Int?
    nonBillableFTEs Int?

    // ── LABOR-6: Utilization
    billableUtilization Float? // percentage 0–100

    // ── LABOR-2: Cost per hour (cross-source — needs QB labor cost)
    laborCostPerHour Float?

    // ── LABOR-7: Revenue per billable FTE (cross-source — needs QB revenue)
    revenuePerBillableFTE Float?

    // ── PS-15: Founder dependency on service delivery
    founderDependencyService Float? // percentage 0–100

    // UI flags
    hasBillableColumn Boolean @default(false) // false = show "set up billable column" prompt
    isStale           Boolean @default(false) // true = background refresh in progress

    // One row per organisation per period
    @@unique([org_id, periodStart, periodEnd])
    @@index([org_id])
    @@map("labor_kpis")
}

model VTO {
    vto_id     String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
    title      String
    year       String
    created_at DateTime @default(now()) @db.Timestamp(6)
    updated_at DateTime @updatedAt @db.Timestamp(6)

    // Relations
    org_id       String       @unique @db.Uuid
    Organisation Organisation @relation(fields: [org_id], references: [org_id], onDelete: Cascade)

    // ─── Core Values (array stored as JSON) ────────────────────────────────────
    core_values Json @default("[]")

    // ─── Core Focus ────────────────────────────────────────────────────────────
    mission String?
    vision  String?

    // ─── 10-Year Targets (array stored as JSON) ────────────────────────────────
    ten_year_targets Json @default("[]")

    // ─── Marketing Strategy ────────────────────────────────────────────────────
    target_market   String?
    proven_process  String?
    differentiators String?
    guarantee       String?

    // ─── 3-Year Picture ────────────────────────────────────────────────────────
    future_date String?
    revenue     String?
    profit      String?
    measurables String?
    look_like   String?

    @@map("vtos")
}
